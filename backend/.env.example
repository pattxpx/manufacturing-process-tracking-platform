# ---- Required in production (the server refuses to start with unsafe values when ENVIRONMENT=production) ----
ENVIRONMENT=development                    # development | production
DATABASE_URL=postgresql+psycopg://localhost:5432/mfg
# The website's address(es), exactly as typed in the browser. Used to check the Origin of requests and WebSockets.
ALLOWED_ORIGINS=http://localhost:3000
# Host names this server answers to. Production: the backend's real host name, never "*".
ALLOWED_HOSTS=localhost,127.0.0.1
# Secure cookies (https only). Defaults to true when ENVIRONMENT=production.
# COOKIE_SECURE=true

# How many reverse proxies in front of the server add their view of the client to X-Forwarded-For (0 = ignore the header).
# Wrong values make rate limits and the audit trail record the wrong address. See the README, section 13.
# TRUSTED_PROXY_HOPS=0

# ---- Optional ----
APP_TIMEZONE=UTC                           # shown times, an IANA name such as Asia/Bangkok. Stored times are always UTC
SESSION_IDLE_MINUTES=120                   # sign out after this long without activity
SESSION_MAX_HOURS=12                       # and after this long in total
API_RATE_LIMIT_PER_MINUTE=1800             # requests per address per minute (flood protection)
MAX_BODY_BYTES=1000000
# ENABLE_API_DOCS=false                    # /docs and /openapi.json. Off by default in production

# Optional: database used by pytest. The name must end in _test because tests drop all tables.
# TEST_DATABASE_URL=postgresql+psycopg://localhost:5432/mfg_test
