# Where the backend is, as seen from the Next.js server. The browser never calls it directly:
# /api/* is passed on to it. Must be set at build time too.
BACKEND_URL=http://localhost:8000
# The backend's live-updates WebSocket as the BROWSER reaches it (wss:// in production).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/production/
